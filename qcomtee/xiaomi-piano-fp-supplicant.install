post_install() {
	cat <<'MSG'
  The supplicant has to be running before fprintd opens the sensor:

    systemctl enable --now xiaomi-fingerprint-supplicant.service

MSG
}

post_upgrade() {
	systemctl is-enabled --quiet xiaomi-fingerprint-supplicant.service 2>/dev/null &&
		echo "  Restart xiaomi-fingerprint-supplicant.service to pick this up."
	return 0
}
