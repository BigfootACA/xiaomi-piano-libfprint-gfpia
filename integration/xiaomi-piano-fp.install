post_install() {
	cat <<'MSG'
  One thing is left to do:

    systemctl enable --now xiaomi-fingerprint-supplicant.service

  Then enrol a finger, either in GNOME's user settings or with
  fprintd-enroll. If the sensor ever stops noticing fingers, delete
  /var/lib/xiaomi-fingerprint/data/vendor_de/0/fpdata/gf_fdt_base.so and
  try again - it is a calibration snapshot that goes stale silently.

MSG
}

post_upgrade() {
	post_install
}
